{
  "name": "walkie",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "description": "Walkie engine: records an app, adds a narrated voice-over and builds an MP4 of a code change. CLI and MCP server.",
  "bin": {
    "walkie": "bin/walkie"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "zod": "4.6.7",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "ajv": "8.17.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --no-warnings tests/schema/validate.ts && scripts/smoke.sh",
    "test:mcp": "node --no-warnings tests/mcp/client.ts"
  },
  "license": "MIT"
}
