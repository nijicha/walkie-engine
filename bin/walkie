#!/bin/sh
# The engine's command line. The Claude Code skill (plugin `walkie` in nijicha/skills) starts
# `walkie mcp`; this sets up and runs everything it needs.
# walkie setup [LANG...]  once per machine: Node packages, Chromium, the engine's tools (bin/wt,
#                built with Rust from mise) and voices; checks ffmpeg. With no language, asks which
#                voices to set up (in a terminal; otherwise keeps the installed ones, or Thai).
#                LANG: th (Thai, MakHam) or en (English, Kokoro).
# walkie setup list  the voices: model, size, installed or not (downloads nothing)
# walkie say LANG OUT.wav "text"  one line with that language's default voice (to try a spelling)
# walkie mcp     MCP server on stdio (for T3 Code, Claude Code, Codex)
# walkie smoke   record the kit smoke test (a static page, no app needed)
# walkie version the engine version
# walkie path    the engine folder (for the skill and scripts that need its files)
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
deps() {
  [ -x "$ROOT/node_modules/.bin/playwright" ] || (cd "$ROOT" && pnpm install --silent) >&2
}
# bin/wt from wt/ (Rust, version in mise.toml). Rebuilt when its sources are newer.
wt() {
  if [ -x "$ROOT/bin/wt" ] && [ -z "$(find "$ROOT/wt/src" "$ROOT/wt/Cargo.toml" "$ROOT/wt/Cargo.lock" -newer "$ROOT/bin/wt" 2>/dev/null | head -1)" ]; then
    return 0
  fi
  command -v mise >/dev/null || { echo "install mise (https://mise.jdx.dev) first: it provides Rust to build bin/wt" >&2; return 1; }
  echo "building bin/wt (Rust; the first build takes a few minutes)" >&2
  (cd "$ROOT" && mise install rust >&2 && mise exec -- cargo build --release --locked --quiet --manifest-path wt/Cargo.toml >&2) || return 1
  cp "$ROOT/wt/target/release/wt" "$ROOT/bin/wt"
}
case "$1" in
  setup)
    shift
    if [ "$1" = list ]; then wt || exit 1; exec "$ROOT/bin/wt" tts --list; fi
    for l in "$@"; do
      case "$l" in th|en) ;; *) echo "unknown language: $l (walkie setup list shows th and en)" >&2; exit 2 ;; esac
    done
    deps
    command -v ffmpeg >/dev/null || { echo "ffmpeg missing: brew install ffmpeg" >&2; exit 1; }
    "$ROOT/node_modules/.bin/playwright" install chromium
    wt || exit 1
    langs="$*"
    if [ -z "$langs" ]; then
      have="$("$ROOT/bin/wt" tts --installed)"
      if [ -t 0 ] && [ -t 1 ]; then
        echo
        "$ROOT/bin/wt" tts --list
        echo
        printf 'Voices to set up, separated by spaces (th, en) [%s]: ' "${have:-th}"
        read -r langs
        langs="${langs:-${have:-th}}"
        for l in $langs; do
          case "$l" in th|en) ;; *) echo "unknown language: $l" >&2; exit 2 ;; esac
        done
      else
        langs="${have:-th}"
      fi
    fi
    for l in $langs; do "$ROOT/bin/wt" tts "$l" --setup || exit 1; done ;;
  say)
    shift
    case "$1" in th|en) [ $# -eq 3 ] || { echo 'usage: walkie say th|en OUT.wav "text"' >&2; exit 2; } ;; *) echo 'usage: walkie say th|en OUT.wav "text"' >&2; exit 2 ;; esac
    wt || exit 1; exec "$ROOT/bin/wt" tts "$@" ;;
  mcp) deps; [ ! -x "$ROOT/bin/wt" ] || wt; exec node --no-warnings "$ROOT/mcp/server.ts" ;;
  smoke) deps; wt || exit 1; exec "$ROOT/scripts/smoke.sh" ;;
  preview) deps; wt || exit 1; shift; exec node --no-warnings "$ROOT/scripts/preview.ts" "$@" ;;
  profile) wt || exit 1; shift; exec "$ROOT/bin/wt" profile "$@" ;;
  version) node -p "require('$ROOT/package.json').version" ;;
  path) echo "$ROOT" ;;
  test) deps; wt || exit 1; (cd "$ROOT/wt" && mise exec -- cargo test --release --quiet) && node --no-warnings "$ROOT/tests/schema/validate.ts" && node --no-warnings "$ROOT/tests/version.test.ts" && "$ROOT/scripts/smoke.sh" ;;
  *) echo "usage: walkie setup [th] [en] | setup list | say th|en OUT.wav \"text\" | mcp | smoke | test | version | path | preview <profile> [out.html] | profile --list | --resolve <name>" >&2; exit 2 ;;
esac
